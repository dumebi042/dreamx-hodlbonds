// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Executor Manager tests > getQueue: SQL query regression check 1`] = `
[
  "SET TRANSACTION ISOLATION LEVEL SERIALIZABLE",
  "select "id", "status", "priority", "earliest_try", "latest_try", "should_retry", "network", "executor", "data", "task_hash", "status_message", "tx_hashes", "attempts", "next_attempt", "previous_attempt_region", "gas_price", "gas_usage", extract(epoch from "earliest_try")::integer, CASE WHEN "latest_try" is null THEN null ELSE extract(epoch from "latest_try")::integer END, CASE WHEN "next_attempt" is null THEN null ELSE extract(epoch from "next_attempt")::integer END from "queue" where ("queue"."network" = $1 and "queue"."status" = $2 and "queue"."earliest_try" <= now() and ("queue"."next_attempt" is null OR "queue"."next_attempt" <= now()) and (("queue"."latest_try" is null AND "queue"."earliest_try" + $3::interval >= now()) OR "queue"."latest_try" >= now())) order by "queue"."priority" asc, "queue"."earliest_try" asc limit $4",
  "select "id", "status", "priority", "earliest_try", "latest_try", "should_retry", "network", "executor", "data", "task_hash", "status_message", "tx_hashes", "attempts", "next_attempt", "previous_attempt_region", "gas_price", "gas_usage", extract(epoch from "earliest_try")::integer, CASE WHEN "latest_try" is null THEN null ELSE extract(epoch from "latest_try")::integer END, CASE WHEN "next_attempt" is null THEN null ELSE extract(epoch from "next_attempt")::integer END from "queue" where ("queue"."network" = $1 and "queue"."status" = $2 and "queue"."earliest_try" <= now() and ("queue"."next_attempt" is null OR "queue"."next_attempt" <= now()) and (("queue"."latest_try" is null AND "queue"."earliest_try" + $3::interval >= now()) OR "queue"."latest_try" >= now()) and ("queue"."previous_attempt_region" != $4 OR "queue"."next_attempt" + $5::interval < now())) order by "queue"."priority" asc, "queue"."earliest_try" asc limit $6",
  "select "id", "status", "priority", "earliest_try", "latest_try", "should_retry", "network", "executor", "data", "task_hash", "status_message", "tx_hashes", "attempts", "next_attempt", "previous_attempt_region", "gas_price", "gas_usage", extract(epoch from "earliest_try")::integer, CASE WHEN "latest_try" is null THEN null ELSE extract(epoch from "latest_try")::integer END, CASE WHEN "next_attempt" is null THEN null ELSE extract(epoch from "next_attempt")::integer END from "queue" where ("queue"."network" = $1 and "queue"."status" = $2 and "queue"."earliest_try" <= now() and ("queue"."next_attempt" is null OR "queue"."next_attempt" <= now()) and (("queue"."latest_try" is null AND "queue"."earliest_try" + $3::interval >= now()) OR "queue"."latest_try" >= now()) and not "queue"."id" in ($4, $5, $6)) order by "queue"."priority" asc, "queue"."earliest_try" asc limit $7",
  "update "queue" set "status" = $1 where "queue"."id" in ($2, $3, $4, $5, $6, $7)",
]
`;
