#
# Cloud Build configuration for Intake Cloud Functions
# This file uses Cloud Build to deploy Gen2 Cloud Functions on push
#

steps:
  # Install pnpm
  - name: "node:24-alpine"
    entrypoint: sh
    args:
      - "-c"
      - "corepack enable && corepack prepare pnpm@latest --activate"

  # Install dependencies (monorepo-aware)
  - name: "node:24-alpine"
    entrypoint: sh
    args:
      - "-c"
      - "corepack enable && pnpm install --frozen-lockfile"
    env:
      - "HOME=/workspace"

  # Build intake package (builds workspace dependencies automatically)
  - name: "node:24-alpine"
    entrypoint: sh
    args:
      - "-c"
      - "corepack enable && pnpm --filter=@hodlbonds-blockchain-executor/intake... build"
    env:
      - "HOME=/workspace"

  # Pack workspace dependencies into tarballs
  # This creates standalone .tgz files that npm can install
  - name: "node:24-alpine"
    entrypoint: sh
    args:
      - "-c"
      - |
        corepack enable
        mkdir -p /workspace/apps/intake/dist-deploy/tarballs
        cd /workspace/packages/dto && pnpm pack --pack-destination /workspace/apps/intake/dist-deploy/tarballs
        cd /workspace/packages/database && pnpm pack --pack-destination /workspace/apps/intake/dist-deploy/tarballs
    env:
      - "HOME=/workspace"

  # Create deployment directory with intake app and package.json referencing tarballs
  - name: "node:24-alpine"
    entrypoint: sh
    args:
      - "-c"
      - |
        cd /workspace/apps/intake
        # Copy built intake code
        mkdir -p dist-deploy/dist
        cp -r dist/* dist-deploy/dist/
        # Copy original package.json and rewrite workspace dependencies to point to tarballs
        cp package.json dist-deploy/package.json
        cd dist-deploy
        node -e "
        const fs = require('fs');
        const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8'));
        
        // Read version from root package.json (all packages use same version)
        const rootPkg = JSON.parse(fs.readFileSync('/workspace/package.json', 'utf8'));
        const version = rootPkg.version;

        // Read catalog from workspace root
        const yaml = fs.readFileSync('/workspace/pnpm-workspace.yaml', 'utf8');
        const catalog = {};
        const catalogMatch = yaml.match(/catalog:([\\s\\S]*?)(?:\\n\\w|$)/);
        if (catalogMatch) {
          const catalogSection = catalogMatch[1];
          catalogSection.split('\\n').forEach(line => {
            const match = line.match(/^\\s+(\\S+):\\s+(.+)$/);
            if (match) {
              catalog[match[1]] = match[2];
            }
          });
        }

        if (pkg.dependencies) {
          Object.keys(pkg.dependencies).forEach(dep => {
            if (pkg.dependencies[dep].startsWith('workspace:')) {
              // Replace workspace:* with file: reference to tarball
              const tarballName = dep.replace('@dreamx-development/hodlbonds-blockchain-executor-', 'dreamx-development-hodlbonds-blockchain-executor-');
              pkg.dependencies[dep] = \`file:tarballs/\${tarballName}-\${version}.tgz\`;
            }
            if (pkg.dependencies[dep].startsWith('catalog:')) {
              // Replace catalog: with actual version from catalog
              pkg.dependencies[dep] = catalog[dep] || '*';
            }
          });
        }
        // Remove devDependencies (not needed in deployment)
        delete pkg.devDependencies;
        // Remove scripts that aren't needed
        if (pkg.scripts) {
          pkg.scripts = { start: pkg.scripts.start };
        }
        fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2));
        "
<% for(let executor of executors) { %>
  # Deploy function for <%= executor %>
  - name: "gcr.io/cloud-builders/gcloud"
    args:
      - functions
      - deploy
      - $BRANCH_NAME-intake-<%= executor %>
      - --gen2
      - --source=./apps/intake/dist-deploy
      - --entry-point=blockchainExecutorIntake
      - --runtime=nodejs24
      - --trigger-topic=$BRANCH_NAME-intake-<%= executor %>
      - --set-env-vars=EXECUTOR=<%= executor %>
      - --set-env-vars=DB_USER=hodlbonds-intake@$PROJECT_ID.iam
      - --set-env-vars=DB_INSTANCE_ID=$PROJECT_ID:us-central1:blockchain-executor-db
      - --set-env-vars=DB_NAME=blockchain_executor_$BRANCH_NAME
      - --set-env-vars=NODE_ENV=production
      - --set-env-vars=BRANCH=$BRANCH_NAME
      - --set-env-vars=LOG_LEVEL=info
      - --service-account=hodlbonds-intake@$PROJECT_ID.iam.gserviceaccount.com
      - --build-service-account=projects/$PROJECT_ID/serviceAccounts/hodlbonds-intake-deployer@$PROJECT_ID.iam.gserviceaccount.com
      - --ingress-settings=internal-only
      - --retry
      - --region=us-central1
      - --max-instances=3

  # Configure Cloud SQL connection for <%= executor %> (Gen2 functions require separate step)
  - name: "gcr.io/cloud-builders/gcloud"
    args:
      - run
      - services
      - update
      - $BRANCH_NAME-intake-<%= executor.toLowerCase() %>
      - --add-cloudsql-instances=$PROJECT_ID:us-central1:blockchain-executor-db
      - --region=us-central1

  # Grant runtime service account permission to invoke the function (for Pub/Sub push)
  - name: "gcr.io/cloud-builders/gcloud"
    args:
      - run
      - services
      - add-iam-policy-binding
      - $BRANCH_NAME-intake-<%= executor.toLowerCase() %>
      - --region=us-central1
      - --member=serviceAccount:hodlbonds-intake@$PROJECT_ID.iam.gserviceaccount.com
      - --role=roles/run.invoker
<% } %>
options:
  logging: CLOUD_LOGGING_ONLY
