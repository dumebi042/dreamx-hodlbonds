{
  "name": "hodlbonds-api",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "check-types:tsgo": "pnpm -r check-types:tsgo",
    "dev:native": "pnpm --filter native dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "db:push": "pnpm --filter @hodlbonds-api/db db:push",
    "db:studio": "pnpm --filter @hodlbonds-api/db db:studio",
    "db:generate": "pnpm --filter @hodlbonds-api/db db:generate",
    "db:migrate": "pnpm --filter @hodlbonds-api/db db:migrate",
    "db:start": "pnpm --filter @hodlbonds-api/db db:start",
    "db:watch": "pnpm --filter @hodlbonds-api/db db:watch",
    "db:stop": "pnpm --filter @hodlbonds-api/db db:stop",
    "db:down": "pnpm --filter @hodlbonds-api/db db:down",
    "format": "pnpm -r format",
    "lint": "pnpm -r lint",
    "lint:types": "pnpm -r lint --type-aware",
    "test": "vitest --coverage"
  },
  "devDependencies": {
    "@hodlbonds-api/config": "workspace:*",
    "@types/node": "^24.10.13",
    "@typescript/native-preview": "^7.0.0-dev.20260211.1",
    "@vitest/coverage-v8": "4.0.18",
    "oxfmt": "^0.31.0",
    "oxlint": "^1.46.0",
    "oxlint-tsgolint": "^0.12.0",
    "tsdown": "^0.20.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
